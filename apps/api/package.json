{
  "name": "@tunion/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:ensure": "tsx src/db/ensure.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/seed.ts --reset",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@tunion/shared": "*",
    "cors": "^2.8.5",
    "express": "^5.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0"
  }
}
