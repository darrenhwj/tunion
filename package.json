{
  "name": "tunion",
  "private": true,
  "version": "0.1.0",
  "description": "TUnion - a university CS peer learning community (hackathon demo)",
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "predev": "npm run db:ensure -w @tunion/api",
    "dev": "concurrently -k -n api,web -c blue,green \"npm run dev -w @tunion/api\" \"npm run dev -w @tunion/web\"",
    "dev:api": "npm run dev -w @tunion/api",
    "dev:web": "npm run dev -w @tunion/web",
    "build": "npm run build -w @tunion/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @tunion/api",
    "db:seed": "npm run db:seed -w @tunion/api",
    "db:reset": "npm run db:reset -w @tunion/api"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.6.0"
  }
}
